# Safe default: deterministic mock mode does not access a GPU or network.
INFERENCE_MODE=mock
MODEL_ALIAS=mock
MODEL_REVISION=main
QUANTIZATION=none

INPUT_MAX_CHARS=50000
MAX_NEW_TOKENS=2048
RETRY_CAP=1
MAX_FILE_SIZE_BYTES=10485760
MAX_PDF_PAGES=30
MAX_DECOMPRESSED_SIZE_BYTES=52428800
ARTIFACT_PATH=artifacts
LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-ID

# Phase P3 Colab example (requires a new application lifecycle):
# INFERENCE_MODE=transformers
# MODEL_ALIAS=qwen14b
# QUANTIZATION=nf4-4bit
